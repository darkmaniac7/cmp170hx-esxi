+    /* Directed speed change, then wait for the LTSSM to settle. */
+    cfg0Now = GPU_REG_RD32(pGpu, CMP580_PCIE_XP_CFG0);
+    GPU_REG_WR32(pGpu, CMP580_PCIE_XP_CFG0,
