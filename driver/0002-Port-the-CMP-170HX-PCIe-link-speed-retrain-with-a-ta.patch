+    linkCtrlStat = GPU_REG_RD32(pGpu, CMP580_PCIE_XVE_LINK_CTRL_STAT);
+    NV_PRINTF(LEVEL_ERROR,
+              "CMP580: pcie retrain done gen=%u polls=%u%s XP_CFG0=0x%08x "
+              "LinkCtrlStat=0x%08x speed=%u width=x%u\n",
+              gen, polls, bBusy ? " (LTSSM still busy)" : "", cfg0After, linkCtrlStat,
