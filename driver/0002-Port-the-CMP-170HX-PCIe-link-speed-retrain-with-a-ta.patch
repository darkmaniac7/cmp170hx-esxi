From 0e836aa40357f2359581a33a318f05013a82df50 Mon Sep 17 00:00:00 2001
From: darkmaniac7 <darkmaniac7@users.noreply.github.com>
Date: Sun, 18 Oct 2026 17:55:16 -0500
Subject: [PATCH 2/4] Port the CMP 170HX PCIe link-speed retrain with a
 target-generation parameter

Port the cmpunlocker _cmpRetrainGen2 reference into the 580.178.04 CMP
backport. The retrain runs inside the existing CMP unlock block of
_kgspBootGspRm(), after the memory/SS postcondition check and before the
stock signature is rebuilt, the point the reference uses, so the host-side
XP writes land while the PLM gates are open.

- Open the PCIe subset of the reference PLM table through the SEC2 Booter
  (XVE, XVE_B, XVE_C, XVE_PLM, XVE_CYA_PLM, XVE_FUSE_OVR, XVE_CYA_SPD,
  XVE_TARGET), one Booter Load per entry, non-fatal, WPR2 restored each round.
- Host-side XP programming: clear the XP_CYA0 Gen1 pins, set the XP_CFG0 max
  rate field (the reference value 2, or 3 for Gen4), select the target speed
  in XP_LCTRL2 [19:16], write the upstream port LnkCtl2 target speed when the
  port is known (logged, never required), trigger the directed speed change
  through XP_CFG0 bit 0 and poll the LTSSM busy bit 4.
- New module parameter NVreg_CmpPcieTargetGen (regkey CmpPcieTargetGen):
  0 = no retrain, 1..4 = PCIe generation to request, default 2; values
  above 4 disable the retrain and are logged.
- Read-back logging as "CMP580: pcie retrain" lines: LnkCap (BAR0 mirror
  and config space), LnkCtlSta speed/width, LnkCtl2, the XP registers,
  every gate round, the root-port write and the final link state.
- Re-check the memory/SS postcondition after the extra Booter rounds and
  abort the boot if it no longer holds.
- No behaviour change for non-CMP devices (PCI IDs 0x20C2/0x2082 only)
  or when the parameter is 0.
---
 kernel-open/nvidia/nv-reg.h                   |  22 ++
 src/nvidia/arch/nvalloc/unix/include/nv-reg.h |  22 ++
 src/nvidia/interface/nvrm_registry.h          |  13 +
 src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c    | 308 ++++++++++++++++++
 4 files changed, 365 insertions(+)

diff --git a/kernel-open/nvidia/nv-reg.h b/kernel-open/nvidia/nv-reg.h
index 0ccf14c..592619b 100644
--- a/kernel-open/nvidia/nv-reg.h
+++ b/kernel-open/nvidia/nv-reg.h
@@ -766,6 +766,26 @@
 #define __NV_ENABLE_GPU_FIRMWARE_LOGS  EnableGpuFirmwareLogs
 #define NV_REG_ENABLE_GPU_FIRMWARE_LOGS NV_REG_STRING(__NV_ENABLE_GPU_FIRMWARE_LOGS)
 
+/*
+ * Option: CmpPcieTargetGen
+ *
+ * CMP 170HX (PCI device 0x20C2 / 0x2082) only; no effect on any other GPU.
+ * The CMP VBIOS leaves the PCIe link pinned at Gen1. During the CMP unlock
+ * (the SEC2 Booter window) the driver can open the XVE/XP gates and ask the
+ * link to retrain at a higher generation. Read-backs are logged as
+ * "CMP580: pcie retrain" lines.
+ *
+ * Possible values:
+ *  0    - never touch the link (the accepted 580.178.04 CMP behaviour).
+ *  1..4 - PCIe generation to request. Gen2 (5 GT/s) is what the reference
+ *         unlock proves; Gen3 and Gen4 are attempts.
+ *  Any other value disables the retrain and is logged.
+ *  Default: 2.
+ */
+#define __NV_CMP_PCIE_TARGET_GEN CmpPcieTargetGen
+#define NV_REG_CMP_PCIE_TARGET_GEN NV_REG_STRING(__NV_CMP_PCIE_TARGET_GEN)
+#define NV_REG_CMP_PCIE_TARGET_GEN_DEFAULT 2
+
 /*
  * Option: EnableDbgBreakpoint
  *
@@ -999,6 +1019,7 @@ NV_DEFINE_REG_ENTRY_GLOBAL(__NV_IMEX_CHANNEL_COUNT, 2048);
 NV_DEFINE_REG_ENTRY_GLOBAL(__NV_CREATE_IMEX_CHANNEL_0, 0);
 NV_DEFINE_REG_ENTRY_GLOBAL(__NV_GRDMA_PCI_TOPO_CHECK_OVERRIDE,
                            NV_REG_GRDMA_PCI_TOPO_CHECK_OVERRIDE_DEFAULT);
+NV_DEFINE_REG_ENTRY(__NV_CMP_PCIE_TARGET_GEN, NV_REG_CMP_PCIE_TARGET_GEN_DEFAULT);
 
 /*
  *----------------registry database definition----------------------
@@ -1048,6 +1069,7 @@ nv_parm_t nv_parms[] = {
     NV_DEFINE_PARAMS_TABLE_ENTRY(__NV_IMEX_CHANNEL_COUNT),
     NV_DEFINE_PARAMS_TABLE_ENTRY(__NV_CREATE_IMEX_CHANNEL_0),
     NV_DEFINE_PARAMS_TABLE_ENTRY(__NV_GRDMA_PCI_TOPO_CHECK_OVERRIDE),
+    NV_DEFINE_PARAMS_TABLE_ENTRY(__NV_CMP_PCIE_TARGET_GEN),
     {NULL, NULL}
 };
 
