+                  "CMP580: pcie retrain: memory/SS postcondition no longer holds; "
+                  "aborting boot (set NVreg_CmpPcieTargetGen=0 to bypass)\n");
+        return NV_ERR_INVALID_STATE;
+    }
+
+    return NV_OK;
+}
