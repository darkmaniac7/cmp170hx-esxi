From 37350a252d8d9dfa405e8a7558135b8472efecbd Mon Sep 17 00:00:00 2001
From: darkmaniac7 <darkmaniac7@users.noreply.github.com>
Date: Sun, 18 Oct 2026 23:24:30 -0500
Subject: [PATCH 3/4] Add the CMP 170HX ECC hardware-recipe experiment behind
 NVreg_CmpEccRecipe

Ports only the hardware half of cmpunlocker v0.5 ecc-enable.patch (14 SEC2
post-Booter register writes plus upstream WPR/VPR/lock teardown) into the
unlock window after the PCIe retrain, gated by a new DWORD registry key
CmpEccRecipe (default 0, per-device capable). Every write and read-back and
the before/after readouts are logged as CMP580: ecc recipe lines. No ECC
reporting path is changed; RM re-reads the hardware readout afterwards.
---
 kernel-open/nvidia/nv-reg.h                   |  18 ++
 src/nvidia/arch/nvalloc/unix/include/nv-reg.h |  18 ++
 src/nvidia/interface/nvrm_registry.h          |  15 ++
 src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c    | 167 ++++++++++++++++++
 4 files changed, 218 insertions(+)

diff --git a/kernel-open/nvidia/nv-reg.h b/kernel-open/nvidia/nv-reg.h
index 592619b..a7a1da6 100644
--- a/kernel-open/nvidia/nv-reg.h
+++ b/kernel-open/nvidia/nv-reg.h
@@ -786,6 +786,22 @@
 #define NV_REG_CMP_PCIE_TARGET_GEN NV_REG_STRING(__NV_CMP_PCIE_TARGET_GEN)
 #define NV_REG_CMP_PCIE_TARGET_GEN_DEFAULT 2
 
+/*
+ * Option: CmpEccRecipe
+ *
+ * Description:
+ *
+ * CMP 170HX only. 1 applies the experimental cmpunlocker ECC hardware recipe
+ * (14 register writes through the SEC2 post-Booter payload) during the
+ * unlock window and logs every write and read-back; 0 does nothing. Nothing
+ * about ECC reporting is changed by this option.
+ *
+ * Default: 0.
+ */
+#define __NV_CMP_ECC_RECIPE CmpEccRecipe
+#define NV_REG_CMP_ECC_RECIPE NV_REG_STRING(__NV_CMP_ECC_RECIPE)
+#define NV_REG_CMP_ECC_RECIPE_DEFAULT 0
+
 /*
  * Option: EnableDbgBreakpoint
  *
@@ -1020,6 +1036,7 @@ NV_DEFINE_REG_ENTRY_GLOBAL(__NV_CREATE_IMEX_CHANNEL_0, 0);
 NV_DEFINE_REG_ENTRY_GLOBAL(__NV_GRDMA_PCI_TOPO_CHECK_OVERRIDE,
                            NV_REG_GRDMA_PCI_TOPO_CHECK_OVERRIDE_DEFAULT);
 NV_DEFINE_REG_ENTRY(__NV_CMP_PCIE_TARGET_GEN, NV_REG_CMP_PCIE_TARGET_GEN_DEFAULT);
+NV_DEFINE_REG_ENTRY(__NV_CMP_ECC_RECIPE, NV_REG_CMP_ECC_RECIPE_DEFAULT);
 
 /*
  *----------------registry database definition----------------------
@@ -1070,6 +1087,7 @@ nv_parm_t nv_parms[] = {
     NV_DEFINE_PARAMS_TABLE_ENTRY(__NV_CREATE_IMEX_CHANNEL_0),
     NV_DEFINE_PARAMS_TABLE_ENTRY(__NV_GRDMA_PCI_TOPO_CHECK_OVERRIDE),
     NV_DEFINE_PARAMS_TABLE_ENTRY(__NV_CMP_PCIE_TARGET_GEN),
+    NV_DEFINE_PARAMS_TABLE_ENTRY(__NV_CMP_ECC_RECIPE),
     {NULL, NULL}
 };
 
