+
 /*
  * Option: EnableDbgBreakpoint
  *
@@ -1037,6 +1053,7 @@ NV_DEFINE_REG_ENTRY_GLOBAL(__NV_GRDMA_PCI_TOPO_CHECK_OVERRIDE,
                            NV_REG_GRDMA_PCI_TOPO_CHECK_OVERRIDE_DEFAULT);
 NV_DEFINE_REG_ENTRY(__NV_CMP_PCIE_TARGET_GEN, NV_REG_CMP_PCIE_TARGET_GEN_DEFAULT);
 NV_DEFINE_REG_ENTRY(__NV_CMP_ECC_RECIPE, NV_REG_CMP_ECC_RECIPE_DEFAULT);
+NV_DEFINE_REG_ENTRY(__NV_CMP_SM_RECONFIG, NV_REG_CMP_SM_RECONFIG_DEFAULT);
 
 /*
  *----------------registry database definition----------------------
@@ -1088,6 +1105,7 @@ nv_parm_t nv_parms[] = {
     NV_DEFINE_PARAMS_TABLE_ENTRY(__NV_GRDMA_PCI_TOPO_CHECK_OVERRIDE),
     NV_DEFINE_PARAMS_TABLE_ENTRY(__NV_CMP_PCIE_TARGET_GEN),
