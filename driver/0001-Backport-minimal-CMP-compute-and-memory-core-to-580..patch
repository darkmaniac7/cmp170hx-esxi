+static NV_STATUS
+_kgspSec2PostblTimingPublishGeometry(OBJGPU *pGpu, KernelGsp *pKernelGsp)
+{
+    GspStaticConfigInfo *pGSCI = GPU_GET_GSP_STATIC_INFO(pGpu);
+    NV2080_CTRL_CMD_FB_GET_FB_REGION_INFO_PARAMS *pInfo = &pGSCI->fbRegionInfoParams;
+    NV2080_CTRL_CMD_FB_GET_FB_REGION_FB_REGION_INFO *pLast;
+    NvU32 cfg1, lmr;
+    NvU64 targetBytes;
+
+    if (!_kgspSec2PostblTimingEnabled(pGpu))
+        return NV_OK;
+    NV_CHECK_OK_OR_RETURN(LEVEL_ERROR, _kgspSec2PostblTimingCheckRegisters(pGpu));
+    NV_CHECK_OK_OR_RETURN(LEVEL_ERROR,
+        _kgspSec2PostblTimingGeometry(pGpu->idInfo.PCIDeviceID >> 16, &cfg1, &lmr, &targetBytes));
+    if (SEC2_POSTBL_TIMING_WPR_META(pKernelGsp) == NULL ||
+        SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)->fbSize != targetBytes)
+        return NV_ERR_INVALID_STATE;
+    NV_PRINTF(LEVEL_ERROR, "SEC2_DEBUG: validating FB bytes=0x%llx target=0x%llx regions=%u\n",
+              pGSCI->fb_length, targetBytes, pInfo->numFBRegions);
+    NV_CHECK_OK_OR_RETURN(LEVEL_ERROR,
+        _kgspSec2PostblTimingValidateFbRegions(pInfo, pGSCI->fb_length, targetBytes,
+            SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)->gspFwWprStart,
+            SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)->gspFwWprEnd));
+    pLast = &pInfo->fbRegion[pInfo->numFBRegions - 1];
+    if (pLast->limit < targetBytes - 1)
+    {
+        pLast->limit = targetBytes - 1;
+        pLast->reserved = pLast->limit - pLast->base + 1;
+    }
+    pGSCI->fb_length = targetBytes;
+    NV_PRINTF(LEVEL_ERROR, "SEC2_DEBUG: verified FB geometry; reserved tail 0x%llx-0x%llx\n",
+              pLast->base, pLast->limit);
+    return NV_OK;
+}
