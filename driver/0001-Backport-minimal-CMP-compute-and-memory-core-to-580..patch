diff --git a/src/nvidia/src/kernel/gpu/gsp/arch/turing/kernel_gsp_tu102.c b/src/nvidia/src/kernel/gpu/gsp/arch/turing/kernel_gsp_tu102.c
index 2ddf527..43842f7 100644
--- a/src/nvidia/src/kernel/gpu/gsp/arch/turing/kernel_gsp_tu102.c
+++ b/src/nvidia/src/kernel/gpu/gsp/arch/turing/kernel_gsp_tu102.c
@@ -54,6 +54,12 @@
 #include "g_all_dcl_pb.h"
 #include "lib/protobuf/prb.h"
 
+#define SEC2_DEBUG_PRI_FEATURE_OVERRIDE_PLM         0x00823804
+#define SEC2_DEBUG_PRI_FEATURE_OVERRIDE_SM_SPEED    0x0082381c
+#define SEC2_DEBUG_PRI_FEATURE_OVERRIDE_SM_SPEED_1  0x00823820
+#define SEC2_DEBUG_PRI_FBPA_CFG1                    0x009a0204
+#define SEC2_DEBUG_PRI_MMU_LMR                      0x00100ce0
+
 static NvBool _kgspIsProcessorSuspended(OBJGPU *pGpu, void *pVoid);
 
 void
@@ -295,6 +301,14 @@ kgspFreeBootArgs_TU102
         pKernelGsp->pGspUCodeRadix3Descriptor = NULL;
     }
 
+    // The saved CMP stock signature has the same lifetime as the boot arguments.
+    if (pKernelGsp->pStockSignatureData != NULL)
+    {
+        portMemFree(pKernelGsp->pStockSignatureData);
+        pKernelGsp->pStockSignatureData = NULL;
+    }
+    pKernelGsp->stockSignatureSize = 0;
+
     // Release signature memory
     if (pKernelGsp->pSignatureMemdesc != NULL)
     {
@@ -516,18 +530,35 @@ kgspBootstrap_TU102
         // Execute FWSEC to setup FRTS if we have a FRTS region.
         if (kgspGetFrtsSize_HAL(pGpu, pKernelGsp) > 0)
         {
-            NV_ASSERT_OR_RETURN(pKernelGsp->pPreparedFwsecCmd != NULL, NV_ERR_INVALID_STATE);
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: FWSEC: pPreparedFwsecCmd=%p frtsSize=0x%x\n",
+                      pKernelGsp->pPreparedFwsecCmd,
+                      kgspGetFrtsSize_HAL(pGpu, pKernelGsp));
 
-            NV_ASSERT_OK_OR_RETURN(kflcnReset_HAL(pGpu, pKernelFalcon));
+            if (pKernelGsp->pPreparedFwsecCmd == NULL)
+            {
+                NV_PRINTF(LEVEL_ERROR, "SEC2_DEBUG: FWSEC cmd is NULL, aborting\n");
+                return NV_ERR_INVALID_STATE;
+            }
+
+            status = kflcnReset_HAL(pGpu, pKernelFalcon);
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: kflcnReset for FWSEC: 0x%x\n", status);
+            if (status != NV_OK) return status;
 
             status = kgspExecuteFwsec_HAL(pGpu, pKernelGsp, pKernelGsp->pPreparedFwsecCmd);
             portMemFree(pKernelGsp->pPreparedFwsecCmd);
             pKernelGsp->pPreparedFwsecCmd = NULL;
 
-            NV_ASSERT_OK_OR_RETURN(status);
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: FWSEC status=0x%x\n", status);
+            if (status != NV_OK) return status;
         }
 
-        NV_ASSERT_OK_OR_RETURN(kflcnResetIntoRiscv_HAL(pGpu, pKernelFalcon));
+        status = kflcnResetIntoRiscv_HAL(pGpu, pKernelFalcon);
+        NV_PRINTF(LEVEL_ERROR,
+                  "SEC2_DEBUG: kflcnResetIntoRiscv: 0x%x\n", status);
+        if (status != NV_OK) return status;
 
         // Load init args into mailbox regs
         kgspProgramLibosBootArgsAddr_HAL(pGpu, pKernelGsp);
@@ -536,6 +567,29 @@ kgspBootstrap_TU102
     // Execute Booter Load
     status = kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp,
                                        _kgspGetBooterLoadArgs(pKernelGsp, bootMode));
+
+    {
+        NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+        if (devId == 0x20C2 || devId == 0x2082)
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: normal BooterLoad status=0x%x\n", status);
+    }
+
+    {
+        NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+        if ((devId == 0x20C2 || devId == 0x2082) && status == NV_OK)
+        {
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: POST-BooterLoad verify PLM=0x%08x SS0=0x%08x SS1=0x%08x "
+                      "CFG1=0x%08x LMR=0x%08x\n",
+                      GPU_REG_RD32(pGpu, SEC2_DEBUG_PRI_FEATURE_OVERRIDE_PLM),
+                      GPU_REG_RD32(pGpu, SEC2_DEBUG_PRI_FEATURE_OVERRIDE_SM_SPEED),
+                      GPU_REG_RD32(pGpu, SEC2_DEBUG_PRI_FEATURE_OVERRIDE_SM_SPEED_1),
+                      GPU_REG_RD32(pGpu, SEC2_DEBUG_PRI_FBPA_CFG1),
+                      GPU_REG_RD32(pGpu, SEC2_DEBUG_PRI_MMU_LMR));
+        }
+    }
+
     if (status != NV_OK)
     {
         NV_PRINTF(LEVEL_ERROR, "failed to execute Booter Load (ucode for initial boot): 0x%x\n", status);
diff --git a/src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c b/src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c
index 775b0f7..23a72c5 100644
--- a/src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c
+++ b/src/nvidia/src/kernel/gpu/gsp/kernel_gsp.c
@@ -95,6 +95,125 @@
 #include "diagnostics/code_coverage_mgr.h"
 #endif
 
+#define SEC2_POSTBL_TIMING_CMP_170HX_8GB_PCI_DEVICE_ID   0x20C2
+#define SEC2_POSTBL_TIMING_CMP_170HX_10GB_PCI_DEVICE_ID 0x2082
+#define SEC2_POSTBL_TIMING_SIGNATURE_SIZE          0x0000f800ULL
+#define SEC2_POSTBL_TIMING_FILL_DWORD              0x000004a7U
+
+#ifdef GSP_FW_WPR_META_V1_H_
+#define SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)      ((pKernelGsp)->pWprMetaV1)
+#define SEC2_POSTBL_TIMING_WPR_META_DESC(pKernelGsp) ((pKernelGsp)->pWprMetaV1Descriptor)
+#else
+#define SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)      ((pKernelGsp)->pWprMeta)
+#define SEC2_POSTBL_TIMING_WPR_META_DESC(pKernelGsp) ((pKernelGsp)->pWprMetaDescriptor)
+#endif
+
+NV_STATUS kgspSec2PostblTimingRefillPayload(OBJGPU *pGpu, KernelGsp *pKernelGsp,
+                                           NvU32 writeAddr, NvU32 writeValue);
+NV_STATUS kgspSec2PostblTimingRebuildStockSignature(OBJGPU *pGpu, KernelGsp *pKernelGsp);
+
+static NvBool
+_kgspSec2PostblTimingEnabled(OBJGPU *pGpu)
+{
+    NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+    return (devId == SEC2_POSTBL_TIMING_CMP_170HX_8GB_PCI_DEVICE_ID ||
+            devId == SEC2_POSTBL_TIMING_CMP_170HX_10GB_PCI_DEVICE_ID);
+}
+
+static NV_STATUS
+_kgspSec2PostblTimingSignatureSize(NvU64 size, NvU64 *pAligned)
+{
+    if (pAligned == NULL || size == 0 || size > NV_U64_MAX - 255)
+        return NV_ERR_INVALID_ARGUMENT;
+    *pAligned = NV_ALIGN_UP64(size, 256);
+    return NV_OK;
+}
+
+static NV_STATUS
+_kgspSec2PostblTimingGeometry(NvU32 devId, NvU32 *pCfg1, NvU32 *pLmr, NvU64 *pBytes)
+{
+    if (pCfg1 == NULL || pLmr == NULL || pBytes == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    if (devId == SEC2_POSTBL_TIMING_CMP_170HX_8GB_PCI_DEVICE_ID)
+    {
+        *pCfg1 = 0x02779000U;
+        *pLmr = 0x0000020BU;
+        *pBytes = 0x0000001000000000ULL;
+    }
+    else if (devId == SEC2_POSTBL_TIMING_CMP_170HX_10GB_PCI_DEVICE_ID)
+    {
+        *pCfg1 = 0x02669000U;
+        *pLmr = 0x0000028AU;
+        *pBytes = 0x0000000A00000000ULL;
+    }
+    else
+        return NV_ERR_NOT_SUPPORTED;
+    return NV_OK;
+}
+
+static NvBool
+_kgspSec2PostblTimingRegisterValuesMatch(NvU32 devId, NvU32 ss0, NvU32 ss1,
+                                      NvU32 cfg1, NvU32 lmr)
+{
+    NvU32 expectedCfg1, expectedLmr;
+    NvU64 fbBytes;
+    return _kgspSec2PostblTimingGeometry(devId, &expectedCfg1, &expectedLmr, &fbBytes) == NV_OK &&
+           ss0 == 0x88888888U && ss1 == 0x00000008U &&
+           cfg1 == expectedCfg1 && lmr == expectedLmr;
+}
+
+static NV_STATUS
+_kgspSec2PostblTimingCheckRegisters(OBJGPU *pGpu)
+{
+    if (!_kgspSec2PostblTimingRegisterValuesMatch(pGpu->idInfo.PCIDeviceID >> 16,
+            GPU_REG_RD32(pGpu, 0x0082381cU), GPU_REG_RD32(pGpu, 0x00823820U),
+            GPU_REG_RD32(pGpu, 0x009a0204U), GPU_REG_RD32(pGpu, 0x00100ce0U)))
+    {
+        NV_PRINTF(LEVEL_ERROR, "SEC2_DEBUG: memory/SS register postcondition failed\n");
+        return NV_ERR_INVALID_STATE;
+    }
+    return NV_OK;
+}
+
+static NV_STATUS
+_kgspSec2PostblTimingValidateFbRegions
+(
+    const NV2080_CTRL_CMD_FB_GET_FB_REGION_INFO_PARAMS *pInfo,
+    NvU64 reportedBytes, NvU64 targetBytes, NvU64 reservedStart, NvU64 wprEnd
+)
+{
+    NvU32 i, j;
+    const NV2080_CTRL_CMD_FB_GET_FB_REGION_FB_REGION_INFO *pLast;
+
+    if (pInfo == NULL || reportedBytes == 0 || reportedBytes > targetBytes ||
+        reservedStart >= wprEnd || wprEnd > targetBytes ||
+        pInfo->numFBRegions == 0 ||
+        pInfo->numFBRegions > NV2080_CTRL_CMD_FB_GET_FB_REGION_INFO_MAX_ENTRIES)
+        return NV_ERR_INVALID_STATE;
+
+    pLast = &pInfo->fbRegion[pInfo->numFBRegions - 1];
+    for (i = 0; i < pInfo->numFBRegions; i++)
+    {
+        const NV2080_CTRL_CMD_FB_GET_FB_REGION_FB_REGION_INFO *pRegion = &pInfo->fbRegion[i];
+        if (pRegion->base > pRegion->limit || pRegion->limit >= reportedBytes ||
+            pRegion->reserved > pRegion->limit - pRegion->base + 1 ||
+            (i + 1 < pInfo->numFBRegions && pRegion->limit >= pLast->base))
+            return NV_ERR_INVALID_STATE;
+        for (j = 0; j < i; j++)
+        {
+            if (pRegion->base <= pInfo->fbRegion[j].limit &&
+                pInfo->fbRegion[j].base <= pRegion->limit)
+                return NV_ERR_INVALID_STATE;
+        }
+    }
+    // Only an already fully reserved terminal region may be extended over WPR.
+    if (pLast->reserved != pLast->limit - pLast->base + 1 || pLast->base > reservedStart)
+        return NV_ERR_INVALID_STATE;
+    return NV_OK;
+}
+
+static NV_STATUS _kgspSec2PostblTimingPublishGeometry(OBJGPU *, KernelGsp *);
+
 #include "crashcat/crashcat_report.h"
 
 #define RPC_HDR  ((rpc_message_header_v*)(pRpc->message_buffer))
@@ -3908,7 +4027,7 @@ _kgspBootGspRm(OBJGPU *pGpu, KernelGsp *pKernelGsp, GSP_FIRMWARE *pGspFw, GPU_MA
     *pbRetry = NV_FALSE;
 
     // Fail early if WPR2 is up
-    if (kgspIsWpr2Up_HAL(pGpu, pKernelGsp) &&
+    if (!_kgspSec2PostblTimingEnabled(pGpu) && kgspIsWpr2Up_HAL(pGpu, pKernelGsp) &&
         (!pGpu->getProperty(pGpu, PDB_PROP_GPU_PREINITIALIZED_WPR_REGION)))
     {
         NV_PRINTF(LEVEL_ERROR, "unexpected WPR2 already up, cannot proceed with booting GSP\n");
@@ -3919,6 +4038,16 @@ _kgspBootGspRm(OBJGPU *pGpu, KernelGsp *pKernelGsp, GSP_FIRMWARE *pGspFw, GPU_MA
     // Populate WPR meta structure (requires knowing FB size on dGPU, which depends on GFW_BOOT)
     NV_CHECK_OK_OR_RETURN(LEVEL_ERROR, kgspPopulateWprMeta_HAL(pGpu, pKernelGsp, pGspFw));
 
+    if (_kgspSec2PostblTimingEnabled(pGpu))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "SEC2_DEBUG: WPR meta fbSize=0x%016llx wprEnd=0x%016llx "
+                  "heapSize=0x%016llx\n",
+                  SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)->fbSize,
+                  SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)->gspFwWprEnd,
+                  SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)->gspFwHeapSize);
+    }
+
     {
         // If the new FB layout requires a scrubber ucode to scrub additional space, prepare it now
         NV_CHECK_OK_OR_RETURN(LEVEL_ERROR, _kgspPrepareScrubberImageIfNeeded(pGpu, pKernelGsp));
@@ -3927,6 +4056,123 @@ _kgspBootGspRm(OBJGPU *pGpu, KernelGsp *pKernelGsp, GSP_FIRMWARE *pGspFw, GPU_MA
     // Setup arguments for bootstrapping GSP
     NV_CHECK_OK_OR_RETURN(LEVEL_ERROR, kgspPrepareForBootstrap_HAL(pGpu, pKernelGsp, KGSP_BOOT_MODE_NORMAL));
 
+    if (_kgspSec2PostblTimingEnabled(pGpu))
+    {
+        NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+        NvU32 plmIdx, attempt;
+        NV_STATUS plmStatus;
+
+        static const struct { NvU32 addr; NvU32 value; const char *name; } plmTable[] = {
+            { 0x001fa7ccU, 0xfffff0ffU, "WPR_CFG" },
+            { 0x009a0148U, 0xffffffffU, "FBPA" },
+            { 0x001fa7c4U, 0xffffffffU, "WPR" },
+            { 0x00823804U, 0xffffffffU, "FEAT" },
+        };
+
+        NvU32 wpr2Lo = GPU_REG_RD32(pGpu, 0x001fa824U);
+        NvU32 wpr2Hi = GPU_REG_RD32(pGpu, 0x001fa828U);
+        NV_PRINTF(LEVEL_ERROR,
+                  "SEC2_DEBUG: saved WPR2 lo=0x%08x hi=0x%08x\n",
+                  wpr2Lo, wpr2Hi);
+
+        for (plmIdx = 0; plmIdx < NV_ARRAY_ELEMENTS(plmTable); plmIdx++)
+        {
+            NvBool opened = NV_FALSE;
+            for (attempt = 0; attempt < 2 && !opened; attempt++)
+            {
+                plmStatus = kgspSec2PostblTimingRefillPayload(pGpu, pKernelGsp,
+                    plmTable[plmIdx].addr, plmTable[plmIdx].value);
+                if (plmStatus != NV_OK)
+                    return plmStatus;
+
+                GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+                GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+
+                plmStatus = kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp,
+                    memdescGetPhysAddr(SEC2_POSTBL_TIMING_WPR_META_DESC(pKernelGsp), AT_GPU, 0));
+
+                NvU32 regVal = GPU_REG_RD32(pGpu, plmTable[plmIdx].addr);
+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: PLM[%u] %s(0x%x) attempt=%u status=0x%x reg=0x%08x\n",
+                          plmIdx, plmTable[plmIdx].name,
+                          plmTable[plmIdx].addr, attempt, plmStatus, regVal);
+
+                if (regVal == plmTable[plmIdx].value)
+                    opened = NV_TRUE;
+            }
+            if (!opened)
+            {
+                GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+                GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+                NV_PRINTF(LEVEL_ERROR,
+                          "SEC2_DEBUG: FAILED to open %s after 2 attempts\n",
+                          plmTable[plmIdx].name);
+                return NV_ERR_INVALID_STATE;
+            }
+        }
+
+        GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+        GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+
+        NV_PRINTF(LEVEL_ERROR,
+                  "SEC2_DEBUG: PLMs: FEAT=0x%08x FBPA=0x%08x WPR=0x%08x WPR_CFG=0x%08x\n",
+                  GPU_REG_RD32(pGpu, 0x00823804U),
+                  GPU_REG_RD32(pGpu, 0x009a0148U),
+                  GPU_REG_RD32(pGpu, 0x001fa7c4U),
+                  GPU_REG_RD32(pGpu, 0x001fa7ccU));
+
+        {
+            NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+            NvU32 cfg1Value;
+            NvU32 lmrValue;
+
+            if (devId == SEC2_POSTBL_TIMING_CMP_170HX_8GB_PCI_DEVICE_ID)
+            {
+                cfg1Value = 0x02779000U;
+                lmrValue  = 0x0000020BU;
+            }
+            else
+            {
+                cfg1Value = 0x02669000U;
+                lmrValue  = 0x0000028AU;
+            }
+
+            GPU_REG_WR32(pGpu, 0x0082381cU, 0x88888888U);
+            GPU_REG_WR32(pGpu, 0x00823820U, 0x00000008U);
+            GPU_REG_WR32(pGpu, 0x009a0204U, cfg1Value);
+            GPU_REG_WR32(pGpu, 0x00100ce0U, lmrValue);
+
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: POST-WRITE SS0=0x%08x SS1=0x%08x "
+                      "CFG1=0x%08x LMR=0x%08x (devId=0x%x)\n",
+                      GPU_REG_RD32(pGpu, 0x0082381cU),
