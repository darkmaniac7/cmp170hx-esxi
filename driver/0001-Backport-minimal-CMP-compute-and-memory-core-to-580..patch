+static NV_STATUS
+_kgspSec2PostblTimingResizeSignature(OBJGPU *pGpu, KernelGsp *pKernelGsp,
+                                   NvU64 size, NvU8 **ppVa)
+{
+    MEMORY_DESCRIPTOR *pNew = NULL;
+    MEMORY_DESCRIPTOR *pOld = pKernelGsp->pSignatureMemdesc;
+    NvU8 *pVa;
+    NV_STATUS status;
+
+    if (size == 0 || ppVa == NULL ||
+        SEC2_POSTBL_TIMING_WPR_META(pKernelGsp) == NULL ||
+        SEC2_POSTBL_TIMING_WPR_META_DESC(pKernelGsp) == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *ppVa = NULL;
+    if (pOld != NULL && memdescGetSize(pOld) == size)
+    {
+        pVa = memdescMapInternal(pGpu, pOld, TRANSFER_FLAGS_NONE);
+        if (pVa == NULL)
+            return NV_ERR_INSUFFICIENT_RESOURCES;
+        *ppVa = pVa;
+        return NV_OK;
+    }
+
+    NV_CHECK_OK_OR_RETURN(LEVEL_ERROR,
+        memdescCreate(&pNew, pGpu, size, 256, NV_TRUE, ADDR_SYSMEM,
+                      NV_MEMORY_CACHED, MEMDESC_FLAGS_ALLOC_IN_UNPROTECTED_MEMORY));
+    memdescTagAlloc(status, NV_FB_ALLOC_RM_INTERNAL_OWNER_UNNAMED_TAG_16, pNew);
+    if (status != NV_OK)
+    {
+        memdescDestroy(pNew);
+        return status;
+    }
+    pVa = memdescMapInternal(pGpu, pNew, TRANSFER_FLAGS_NONE);
+    if (pVa == NULL)
+    {
+        memdescFree(pNew);
+        memdescDestroy(pNew);
+        return NV_ERR_INSUFFICIENT_RESOURCES;
+    }
+    // The new mapping exists before ownership changes. Metadata must never
+    // refer to freed backing, including an error return in the caller.
+    pKernelGsp->pSignatureMemdesc = pNew;
+    SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)->sysmemAddrOfSignature =
+        memdescGetPhysAddr(pNew, AT_GPU, 0);
+    SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)->sizeOfSignature = size;
+    memdescFlushCpuCaches(pGpu, SEC2_POSTBL_TIMING_WPR_META_DESC(pKernelGsp));
+    if (pOld != NULL)
+    {
+        memdescFree(pOld);
+        memdescDestroy(pOld);
+    }
+    *ppVa = pVa;
+    return NV_OK;
+}
+
+NV_STATUS
+kgspSec2PostblTimingRefillPayload(OBJGPU *pGpu, KernelGsp *pKernelGsp,
+                                 NvU32 writeAddr, NvU32 writeValue)
+{
+    NvU8 *pSignatureVa;
+    NV_STATUS status;
+
+    if (!_kgspSec2PostblTimingEnabled(pGpu) ||
+        pKernelGsp->pStockSignatureData == NULL || pKernelGsp->stockSignatureSize == 0 ||
+        SEC2_POSTBL_TIMING_WPR_META(pKernelGsp) == NULL ||
+        SEC2_POSTBL_TIMING_WPR_META_DESC(pKernelGsp) == NULL)
+        return NV_ERR_INVALID_STATE;
+    NV_CHECK_OK_OR_RETURN(LEVEL_ERROR,
+        _kgspSec2PostblTimingResizeSignature(pGpu, pKernelGsp,
+            SEC2_POSTBL_TIMING_SIGNATURE_SIZE, &pSignatureVa));
+
+    status = _kgspSec2PostblTimingFillPayload(pSignatureVa,
+        memdescGetSize(pKernelGsp->pSignatureMemdesc), writeAddr, writeValue);
+
+    memdescUnmapInternal(pGpu, pKernelGsp->pSignatureMemdesc, 0);
+    NV_CHECK_OK_OR_RETURN(LEVEL_ERROR, status);
+    memdescFlushCpuCaches(pGpu, pKernelGsp->pSignatureMemdesc);
+
+    if (SEC2_POSTBL_TIMING_WPR_META(pKernelGsp) != NULL)
+    {
+        SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)->sysmemAddrOfSignature =
+            memdescGetPhysAddr(pKernelGsp->pSignatureMemdesc, AT_GPU, 0);
+        SEC2_POSTBL_TIMING_WPR_META(pKernelGsp)->sizeOfSignature =
+            memdescGetSize(pKernelGsp->pSignatureMemdesc);
+    }
+
+    if (SEC2_POSTBL_TIMING_WPR_META_DESC(pKernelGsp) != NULL)
+        memdescFlushCpuCaches(pGpu, SEC2_POSTBL_TIMING_WPR_META_DESC(pKernelGsp));
+
+    return NV_OK;
+}
